{
  "name": "@subsentry/backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply subsentry-db --local",
    "db:migrate:prod": "wrangler d1 migrations apply subsentry-db --remote",
    "db:seed:local": "wrangler d1 execute subsentry-db --local --file=./src/db/seed.sql",
    "db:seed:prod": "wrangler d1 execute subsentry-db --remote --file=./src/db/seed.sql",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "better-sqlite3": "^13.0.2",
    "drizzle-kit": "^0.31.10",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.34"
  }
}
