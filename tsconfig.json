{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["@cloudflare/workers-types"],
    "paths": {
      "@/*": ["./apps/backend/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", ".wrangler"]
}
